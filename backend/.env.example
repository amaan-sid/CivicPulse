MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/civicpulse
BACKEND_PORT=4000
JWT_SECRET=replace-with-a-long-random-secret
NODE_ENV=development
CORS_ORIGINS=https://your-frontend-domain.vercel.app

# Signing secret for authentication tokens (use a strong 32+ char value in production)
JWT_SECRET=civicpulse-dev-secret-change-in-production

# Session token lifetime in hours (default: 168 = 7 days)
JWT_TTL_HOURS=168
