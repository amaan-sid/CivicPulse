{
  "compilerOptions": {
    "target": "ES2020",
    "module": "Node16",
    "moduleResolution": "node16",
    "rootDir": "src",
    "outDir": "dist",
    "esModuleInterop": true,
    "strict": false,
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"]
    },
    "lib": ["ES2020"],
    "skipLibCheck": true
  },
  "include": ["src/**/*"]
}